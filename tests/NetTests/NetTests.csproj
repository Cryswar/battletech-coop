<Project Sdk="Microsoft.NET.Sdk">

  <!-- Headless tests for the Unity-free network core (src/BattletechCoop/Net/Core).
       Compiles the same source files the mod uses; no game install or NuGet packages needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\src\BattletechCoop\Net\Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
